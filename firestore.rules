rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict read and write access under /users/{userId} and all its subcollections
    // to the owner of the data (authenticated user with matching UID)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
