rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user spaces under users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Portfolio items (Signature Dishes):
      // Only the authenticated owner whose email is 'warmcomfortforyou@gmail.com' can add, edit, or delete dishes.
      match /portfolio/{itemId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && request.auth.token.email == 'warmcomfortforyou@gmail.com';
      }
      
      // Guestbook reviews:
      // Any authenticated user can create/write reviews under their space,
      // but only 'warmcomfortforyou@gmail.com' can delete or update reviews.
      match /guestbook/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete, update: if request.auth != null && request.auth.uid == userId && request.auth.token.email == 'warmcomfortforyou@gmail.com';
      }
    }
  }
}
